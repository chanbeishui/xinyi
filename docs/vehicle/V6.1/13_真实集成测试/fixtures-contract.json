        "providerRunId",
        "runId",
        "vehicleTypeCode",
        "vehiclePlate",
        "privacyVersion"
      ],
      "properties": {
        "providerRunId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "vehicleTypeCode": {
          "type": "string",
          "enum": [
            "TEST_CAR"
          ]
        },
        "vehiclePlate": {
          "type": "string"
        },
        "privacyVersion": {
          "type": "string",
          "enum": [
            "TEST_PRIVACY_V1"
          ]
