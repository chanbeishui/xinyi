{
  "fixture": [
    "IDENTITY",
    "BOOKING"
  ],
  "testOnly": true,
  "sourceOfTruth": "Test-classpath FixtureApplicationService using actual framework/config services",
  "request": {
    "fixture": "IDENTITY or BOOKING",
