[
  {
    "name": "vi_handover",
    "comment": "一次实物交接事务凭证",
    "cols": [
      [
        "id",
        "BIGINT NOT NULL AUTO_INCREMENT",
        "数据库AUTO_INCREMENT生成内部Long；API输出十进制字符串"
      ],
      [
        "order_id",
        "BIGINT NOT NULL",
        "订单"
      ],
      [
        "assignment_id",
        "BIGINT NOT NULL",
        "当前承接"
      ],
      [
        "handover_type",
        "VARCHAR(32) NOT NULL",
        "HandoverType: OWNER_TO_DRIVER,DRIVER_TO_STATION,STATION_TO_DRIVER,DRIVER_TO_OWNER"
      ],
      [
        "holder_account_id",
        "BIGINT NOT NULL",
        "持码基础账号"
      ],
      [
        "verifier_account_id",
        "BIGINT NOT NULL",
        "核验基础账号"
      ],
      [
        "code_mac",
        "BINARY(32) NOT NULL",
        "含订单/类型/代次随机盐的服务端带密钥MAC；4位码不能只裸哈希"
      ],
      [
        "code_cipher",
        "VARBINARY(512) NOT NULL",
        "仅持码方短期读取所需的加密值，使用后销毁可读密文"
      ],
      [
        "generation_no",
        "INT NOT NULL",
        "码代次"
      ],
      [
        "status",
        "VARCHAR(24) NOT NULL",
        "HandoverStatus: PENDING,CONFIRMED,LOCKED,EXPIRED"
      ],
      [
        "expires_at",
        "DATETIME(3) NOT NULL",
        "时效"
      ],
      [
        "confirmed_at",
        "DATETIME(3)",
        "实物交接成功"
      ],
      [
        "evidence_group_id",
        "BIGINT",
        "已经封存证据组"
      ],
      [
        "active_key",
        "VARCHAR(160) GENERATED ALWAYS AS (IF(status='PENDING',CONCAT(order_id,':',assignment_id,':',handover_type),NULL)) STORED",
        "同时仅一个有效码"
      ],
      [
        "created_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "创建时间，统一UTC"
      ],
      [
        "updated_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "UTC更新时间；Mapper每次修改显式SET updated_at=UTC_TIMESTAMP(3)，不依赖连接时区"
      ],
      [
        "version",
        "BIGINT NOT NULL DEFAULT 0",
        "乐观锁版本"
      ]
    ],
    "indexes": [
      "UNIQUE KEY uk_active_handover (active_key)",
      "KEY ix_order_type (order_id,handover_type,confirmed_at)"
    ],
    "rule": "核验方不得读取密文解码接口；码消费/保管转移/封存/释放同一事务",
    "primaryKey": [
      "id"
    ],
    "idStrategy": "MYSQL_AUTO_INCREMENT",
