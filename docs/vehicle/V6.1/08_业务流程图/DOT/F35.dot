digraph F35 {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.38", fontname="Noto Sans CJK SC", fontsize=18, labelloc=t, label="F35 账单级付款凭证与部分付款"];
node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#CFD6E0", fontname="Noto Sans CJK SC", fontsize=12, margin="0.15,0.10"];
edge [color="#74849A", fontname="Noto Sans CJK SC", fontsize=10];
"n1" [label="代驾已确认当前账单"];
"n2" [label="已确认净额是否大于0？",shape=diamond,fillcolor="#EEF4FF"];
"n3" [label="0元无需付款；负额人工核实\n不伪造付款凭证"];
"n4" [label="在系统外实际付款"];
"n5" [label="从本账单录入金额、日期、流水、凭证"];
"n6" [label="锁定账单校验已核实＋待核实预留\n唯一流水、主体与余额"];
"n7" [label="凭证待独立核实，不计已付"];
"n8" [label="独立人员核实是否相符？",shape=diamond,fillcolor="#EEF4FF"];
"n9" [label="退回并释放预留，保留记录"];
"n10" [label="记录可信付款，按账单累加已付"];
"n11" [label="剩余金额为0？",shape=diamond,fillcolor="#EEF4FF"];
"n12" [label="部分付款：所有行显示所在账单部分付款"];
"n13" [label="已付清：成员离开默认未结清列表\n历史可查"];
"n1" -> "n2" [label=""];
"n2" -> "n3" [label="否"];
"n2" -> "n4" [label="是"];
"n4" -> "n5" [label=""];
"n5" -> "n6" [label=""];
"n6" -> "n7" [label="校验通过"];
"n7" -> "n8" [label=""];
"n8" -> "n9" [label="否"];
"n8" -> "n10" [label="是"];
"n10" -> "n11" [label=""];
"n11" -> "n12" [label="否"];
"n12" -> "n4" [label="后续实际支付"];
"n11" -> "n13" [label="是"];
}