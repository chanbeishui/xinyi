digraph F03 {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.38", fontname="Noto Sans CJK SC", fontsize=18, labelloc=t, label="F03 员工请求、凭证签发与受控绑定"];
node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#CFD6E0", fontname="Noto Sans CJK SC", fontsize=12, margin="0.15,0.10"];
edge [color="#74849A", fontname="Noto Sans CJK SC", fontsize=10];
"n1" [label="本人创建绑定请求\n服务端生成requestId/请求号"];
"n2" [label="管理员选择已有sys_user\n核对关系与组织权限"];
"n3" [label="关系及权限有效？",shape=diamond,fillcolor="#EEF4FF"];
"n4" [label="签发限时随机凭证\n绑定request/account/sys_user，仅显示一次"];
"n5" [label="本人提交credential与request版本"];
"n6" [label="凭证未用、未撤销、未过期且本人匹配？",shape=diamond,fillcolor="#EEF4FF"];
"n7" [label="同事务消费凭证并建立唯一绑定\n保留主体审计与安全事件"];
"n8" [label="工作权限与站点授权另行计算\n撤权不删除车主账号"];
"n9" [label="拒绝并保留恢复入口\n不凭手机号相同绑定"];
"n1" -> "n2" [label=""];
"n2" -> "n3" [label=""];
"n3" -> "n4" [label="是"];
"n3" -> "n9" [label="否"];
"n4" -> "n5" [label=""];
"n5" -> "n6" [label=""];
"n6" -> "n7" [label="是"];
"n6" -> "n9" [label="否"];
"n7" -> "n8" [label=""];
}