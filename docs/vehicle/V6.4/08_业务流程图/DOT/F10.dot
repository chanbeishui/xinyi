digraph G {
graph [rankdir=TB,bgcolor="white",fontname="PingFang SC",label="F10 · 自动轮转、扩圈与人工兜底",labelloc=t];
node [shape=box,style="rounded,filled",fontname="PingFang SC",fillcolor="#F2F6FC"];
edge [fontname="PingFang SC"];
base [label="D01当前听单与行政/资格/占用/限制分别有效\n可信活动设备绑定的近期GCJ02位置及联系凭据"];
snapshot [label="读取订单建单冻结服务公司及公司派单策略\n缺失不猜主部门，转人工协调"];
filter [label="仅同公司：显式车型准驾兼容、资格/处罚/半径\n位置/联系/听单未过期且无其它占用"];
cursor [label="公司游标按driver.id循环，距离只过滤\n只有真正发AUTO邀约才推进游标"];
issue [label="原子预占INVITE并发单人邀约\nexpiresAt=min(响应时限、固定批次总截止、听单截止)"];
respond [label="本人在服务端绝对截止内接受？\n6键CAS/会话观察值+UUID，人工同样必须本人响应",shape=diamond];
accept [label="原子建立唯一承接并精确转换占用\n原invite永久映射assignment；回包不冒充新当前任务"];
release [label="拒绝或超时：仅释放本INVITE占用\n同批同司机不重邀，仍在总截止内才继续"];
expand [label="初圈没有可用未邀司机时只扩一圈\n仍无候选或总截止到达→人工等待"];
manual [label="后台按真实订单/司机版本发人工邀约\n撤回仅WAIT_RESPONSE并转人工，不取消订单或释放承接"];
recovery [label="任何失败撤旧有效投影；截止只失效本地操作\n未知保原目标/正文/UUID，409重读后明确再决定"];
scope [label="当前承接仅真实查询与订单详情\nD03计划预览应用、D09履约及N01实投递仍后续"];
base -> snapshot [label="基础条件满足"];
snapshot -> filter [label="冻结信息完整"];
filter -> cursor [label="合格候选"];
cursor -> issue [label="实际发出"];
issue -> respond [label="本人响应"];
respond -> accept [label="接受且当前校验通过"];
respond -> release [label="拒绝/超时"];
release -> filter [label="仍有未邀候选且未总截止"];
filter -> expand [label="初圈无可用未邀候选"];
expand -> filter [label="只扩大一次"];
expand -> manual [label="无候选/总截止"];
manual -> respond [label="司机仍需接受"];
issue -> recovery [label="未知/冲突/过期"];
accept -> scope [label="独立查询当前承接"];
}
