        "VARCHAR(24) NOT NULL",
        "CANCEL_REFUND/REFUND_ONLY"
      ],
      [
        "case_status",
        "VARCHAR(24) NOT NULL DEFAULT 'PENDING_REVIEW'",
        "AfterSaleStatus: PENDING_REVIEW,EXECUTING,CLOSED,REJECTED"
