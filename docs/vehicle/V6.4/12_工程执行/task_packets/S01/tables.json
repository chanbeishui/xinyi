      ],
      [
        "resolved_at",
        "DATETIME(3)",
        "业务及资金均已办结"
      ],
      [
        "active_order",
        "BIGINT GENERATED ALWAYS AS (IF(case_status IN ('PENDING_REVIEW','EXECUTING'),order_id,NULL)) STORED",
        "一个未办结申请"
      ],
      [
        "created_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "UTC"
      ],
      [
        "updated_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "UTC更新时间；Mapper每次修改显式SET updated_at=UTC_TIMESTAMP(3)，不依赖连接时区"
      ],
      [
        "version",
        "BIGINT NOT NULL DEFAULT 0",
        "乐观锁"
      ]
    ],
    "indexes": [
      "UNIQUE KEY uk_case_no (case_no)",
      "UNIQUE KEY uk_active_order (active_order)",
      "KEY ix_review (review_status,created_at)",
      "KEY ix_return (return_state,updated_at)",
      "CONSTRAINT ck_after_amount CHECK (requested_fen>=0 AND (approved_fen IS NULL OR approved_fen>=0))"
    ],
    "rule": "审核时锁订单/支付/申请，预留退款；实际返还后继续同一决定，无二次默认退款审核。",
