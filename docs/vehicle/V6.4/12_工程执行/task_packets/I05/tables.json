[
  {
    "name": "vi_employee_binding",
    "comment": "微信账户与框架员工受控绑定",
    "cols": [
      [
        "id",
        "BIGINT NOT NULL AUTO_INCREMENT",
        "数据库AUTO_INCREMENT生成内部Long；API输出十进制字符串"
      ],
      [
        "account_id",
        "BIGINT NOT NULL",
        "关联vi_account"
      ],
      [
        "sys_user_id",
        "BIGINT NOT NULL",
        "引用现有sys_user，不重建员工"
      ],
      [
        "bound_by",
        "BIGINT NULL",
        "自动关联为NULL，操作者为系统；管理员后续操作单独审计，绝不填假管理员"
      ],
      [
        "bound_at",
        "DATETIME(3) NOT NULL",
        "绑定时间"
      ],
      [
        "revoked_at",
        "DATETIME(3)",
        "解除时间"
      ],
      [
        "active_account",
        "BIGINT GENERATED ALWAYS AS (IF(revoked_at IS NULL, account_id, NULL)) STORED",
        "有效或暂停关联占用；只读生成列"
      ],
      [
        "active_user",
        "BIGINT GENERATED ALWAYS AS (IF(revoked_at IS NULL, sys_user_id, NULL)) STORED",
        "有效或暂停关联占用；与app_id联合唯一"
      ],
      [
        "permission_version",
        "BIGINT NOT NULL DEFAULT 0",
        "员工关联权限版本；撤权事务更新"
      ],
      [
        "app_id",
        "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL",
        "关联应用命名空间"
      ],
      [
        "source",
        "VARCHAR(32) NOT NULL DEFAULT 'WECHAT_PHONE_MATCH'",
        "EmployeeLinkSource: WECHAT_PHONE_MATCH"
      ],
      [
        "status",
        "VARCHAR(24) NOT NULL DEFAULT 'ACTIVE'",
        "EmployeeBindingLifecycle: ACTIVE,SUSPENDED,REVOKED"
      ],
      [
        "phone_lookup",
        "BINARY(32) NOT NULL",
        "关联时一致的规范化手机号HMAC；不是可还原裸手机号"
      ],
      [
        "last_phone_verified_at",
        "DATETIME(3) NOT NULL",
        "最近本人微信手机号核验时间"
      ],
      [
        "employee_auth_version",
        "BIGINT NOT NULL",
        "建立关联时的框架授权版本快照；每次工作请求仍检查当前员工状态和权限"
      ],
      [
        "auto_rebind_blocked",
        "TINYINT NOT NULL DEFAULT 0",
        "管理员撤销后拦截同应用同员工新自动关联；明确allow-rematch才解除"
      ],
      [
        "suspended_reason",
        "VARCHAR(64) NULL",
        "手机号变更、账号停用等失效原因；不泄漏其他账号"
      ],
      [
        "revoked_by",
        "BIGINT NULL",
        "后台受控撤销操作者"
      ],
      [
        "revoked_reason",
        "VARCHAR(500) NULL",
        "解除依据"
      ],
      [
        "created_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "创建时间，统一UTC"
      ],
      [
        "updated_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "UTC更新时间；Mapper每次修改显式SET updated_at=UTC_TIMESTAMP(3)，不依赖连接时区"
      ],
      [
        "version",
        "BIGINT NOT NULL DEFAULT 0",
        "乐观锁版本"
      ]
    ],
    "indexes": [
      "UNIQUE KEY uk_active_account (active_account)",
      "UNIQUE KEY uk_active_user (app_id,active_user)",
      "KEY ix_employee_link_phone (phone_lookup)",
      "KEY ix_employee_link_block (app_id,sys_user_id,auto_rebind_blocked)"
    ],
    "rule": "可信微信手机号唯一匹配有效sys_user自动建立，无员工申请；同应用每账号/每员工至多一个未撤销关联。暂停仍占唯一关系；撤销写永久留痕及防重绑标记；复核修复后须本人新手机号核验，不允许后台直接填openid。关联、权限版本、audit/outbox同事务。",
    "primaryKey": [
      "id"
    ],
    "idStrategy": "MYSQL_AUTO_INCREMENT",
