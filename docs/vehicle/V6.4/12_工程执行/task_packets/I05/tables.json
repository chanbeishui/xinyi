        "id",
        "BIGINT NOT NULL AUTO_INCREMENT",
        "数据库生成内部Long，API字符串"
      ],
      [
        "guard_key",
        "VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL",
        "首期唯一GLOBAL_DIRECTORY；同库轻量互斥，不是用户权限"
      ],
      [
        "created_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "UTC创建时间"
      ],
      [
        "updated_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "更新显式UTC_TIMESTAMP(3)"
      ],
      [
        "version",
        "BIGINT NOT NULL DEFAULT 0",
        "受控CAS版本"
      ]
    ],
    "indexes": [
      "UNIQUE KEY uk_employee_directory_guard (guard_key)"
    ],
    "rule": "首次以唯一guard_key初始化后SELECT FOR UPDATE；员工首次自动绑定与框架手机号/账号状态/新增删除导入变更均经统一服务先锁本行，再锁员工与关联。供应商调用在锁外。首期低频串行，禁止把整个登录业务外部调用放进锁。",
    "primaryKey": [
      "id"
    ],
