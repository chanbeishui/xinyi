      ],
      [
        "cutoff_at",
        "DATETIME(3) NOT NULL",
        "本次数据截点"
      ],
      [
        "status",
        "VARCHAR(24) NOT NULL",
        "StatementStatus: DRAFT,INTERNAL_REVIEW,SENT,DISPUTED,CONFIRMED,VOID"
      ],
      [
        "revision",
        "INT NOT NULL DEFAULT 1",
        "未确认修订版本"
      ],
      [
        "amount_fen",
        "BIGINT NULL",
        "草稿有未核价行时NULL；不是0；金额齐全时为净拟应付"
      ],
      [
        "snapshot_hash",
        "BINARY(32) NOT NULL",
