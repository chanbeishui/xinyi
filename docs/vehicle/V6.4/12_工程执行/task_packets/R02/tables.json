      ],
      [
        "review_status",
        "VARCHAR(24) NOT NULL DEFAULT 'NOT_REQUIRED'",
        "StatementReviewStatus: NOT_REQUIRED,REQUIRED,PENDING,APPROVED,REJECTED"
      ],
      [
        "review_revision",
        "INT",
        "仅对匹配revision和hash的整单复核生效"
      ],
      [
        "published_revision",
        "INT",
        "当前发送给司机的版本；撤回后失效"
      ],
      [
        "published_hash",
        "BINARY(32)",
        "当前有效公开快照SHA256，与public_snapshot_hash一致；内部复核用snapshot_hash"
      ],
      [
        "submitted_by",
        "BIGINT",
        "复核提交人，需与复核人分离"
      ],
      [
        "selection_mode",
        "VARCHAR(24) NOT NULL DEFAULT 'EXPLICIT'",
        "SelectionMode: EXPLICIT"
      ],
      [
        "filter_snapshot",
        "JSON NULL",
        "查询条件留痕，不是组单成员定义；不能据此重跑批量选择"
