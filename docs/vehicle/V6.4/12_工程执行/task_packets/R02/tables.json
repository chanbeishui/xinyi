        "BIGINT",
        "本人微信账户确认"
      ],
      [
        "confirmed_at",
        "DATETIME(3)",
        "实际确认时间"
      ],
      [
        "confirmation_revision",
        "INT",
        "确认的版本"
      ],
      [
        "voided_at",
        "DATETIME(3)",
        "仅未确认账单可作废"
      ],
      [
        "known_amount_fen",
        "BIGINT NOT NULL DEFAULT 0",
        "已填写金额小计；不能冒充完整应付"
      ],
      [
        "unpriced_count",
        "INT NOT NULL DEFAULT 0",
        "待填写行数，发送和确认要求为0"
      ],
      [
        "manual_price_count",
        "INT NOT NULL DEFAULT 0",
