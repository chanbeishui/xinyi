[
  {
    "name": "vi_offline_payment_record",
    "comment": "客户线下收退款证明与核实",
    "cols": [
      [
        "id",
        "BIGINT NOT NULL AUTO_INCREMENT",
        "内部自增Long；API十进制字符串"
      ],
      [
        "payment_id",
        "BIGINT NOT NULL",
        ""
      ],
      [
        "refund_id",
        "BIGINT NULL",
        "仅REFUND有值，必须来自统一审核已批准执行单"
      ],
      [
        "direction",
        "VARCHAR(16) NOT NULL",
        "OfflineProofDirection: COLLECTION,REFUND；"
      ],
      [
        "owner_dept_id",
        "BIGINT NOT NULL",
        "原支付收款主体快照"
      ],
      [
        "amount_fen",
        "BIGINT NOT NULL",
        "本期完整金额；不支持混合/客户拆单付款"
      ],
      [
        "paid_at",
        "DATETIME(3) NOT NULL",
        "真实线下发生时刻"
      ],
      [
        "method",
        "VARCHAR(24) NOT NULL",
        "OfflineProofMethod: CASH,BANK_TRANSFER；"
      ],
      [
        "external_reference_cipher",
        "VARBINARY(1024) NOT NULL",
        "流水/收据编号密文"
      ],
      [
        "reference_hmac",
        "VARCHAR(64) NOT NULL",
        "主体+方向+方式+流水永久去重摘要"
      ],
      [
        "voucher_file_ids",
        "JSON NOT NULL",
        "私有文件，服务端核查归属与可用性"
      ],
      [
        "status",
        "VARCHAR(16) NOT NULL",
        "OfflineProofStatus: SUBMITTED,VERIFIED,REJECTED；"
      ],
      [
        "registered_by",
        "BIGINT NOT NULL",
        ""
      ],
      [
        "registered_at",
        "DATETIME(3) NOT NULL",
        ""
      ],
      [
        "verified_by",
        "BIGINT NULL",
        ""
      ],
      [
        "verified_at",
        "DATETIME(3) NULL",
        ""
      ],
      [
        "register_note",
        "VARCHAR(500) NOT NULL",
        ""
      ],
      [
        "verify_reason",
        "VARCHAR(500) NULL",
        ""
      ],
      [
        "active_payment",
        "BIGINT GENERATED ALWAYS AS (IF(direction='COLLECTION' AND status IN ('SUBMITTED','VERIFIED'),payment_id,NULL)) STORED",
        "当前有效收款证明唯一占位"
      ],
      [
        "active_refund",
        "BIGINT GENERATED ALWAYS AS (IF(direction='REFUND' AND status IN ('SUBMITTED','VERIFIED'),refund_id,NULL)) STORED",
        "当前有效退款证明唯一占位"
      ],
      [
        "created_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "UTC创建时间"
      ],
      [
        "updated_at",
        "DATETIME(3) NOT NULL DEFAULT (UTC_TIMESTAMP(3))",
        "Mapper显式UTC更新时间"
      ],
      [
        "version",
        "BIGINT NOT NULL DEFAULT 0",
        "显式CAS；不是注解自动生效"
      ]
    ],
    "indexes": [
      "UNIQUE KEY uk_offline_reference (owner_dept_id,direction,method,reference_hmac)",
      "UNIQUE KEY uk_offline_payment (active_payment)",
      "UNIQUE KEY uk_offline_refund (active_refund)",
      "KEY ix_offline_status (owner_dept_id,status)"
    ],
    "rule": "非司机报酬付款表。SUBMITTED不记已付；VERIFY事务锁支付/退款与证明，复核人不同；证明不覆盖更改金额。过期资金真实有效也先处理容量冲突。",
    "primaryKey": [
      "id"
    ],
    "idStrategy": "MYSQL_AUTO_INCREMENT",
    "engine": "InnoDB",
    "collation": "utf8mb4_0900_ai_ci",
