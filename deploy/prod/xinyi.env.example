# =====================================================================
# 后端运行环境变量模板
#
# 用法：
#   cp xinyi.env.example /home/xinyi/app/.env
#   chmod 600 /home/xinyi/app/.env        # 只允许运行用户读
#   vim /home/xinyi/app/.env              # 填真实值
#
# ⚠️ systemd 的 EnvironmentFile 不支持引号包裹，值里也不能有空格；
#    等号两侧不要留空格，否则变量名会带空格。
# =====================================================================

# 数据库账号：在 1panel「数据库」里为本库单独建，不要用 root
XINYI_DB_USER=xinyi

# 数据库密码：建库时设置的那个
XINYI_DB_PASSWORD=CHANGE_ME

# Redis 密码：1panel Redis 应用详情页的密码字段
XINYI_REDIS_PASSWORD=CHANGE_ME

# 令牌签名密钥：用下面的命令生成 48 字节随机串，粘贴进来
#   openssl rand -base64 48 | tr -d '\n'
# 不要沿用开发配置里的短串，也不要提交进 Git
XINYI_TOKEN_SECRET=CHANGE_ME

# ---- 荣利影像对象存储（阿里云 OSS，必填；缺失会导致上传失败）----
# 必须用【公网】endpoint，例如 oss-cn-hangzhou.aliyuncs.com
# 不要用带 -internal 的内网 endpoint：小程序拿到的短链是后端用该 endpoint 签出来的，
# 内网域名手机端解析不到，表现为「上传成功但图片打不开」。
# 公网上传流量免费，成本上不吃亏。
RONGLI_OSS_ENABLED=true
RONGLI_OSS_ENDPOINT=oss-cn-XXXXXXXX.aliyuncs.com
RONGLI_OSS_BUCKET=CHANGE_ME
RONGLI_OSS_ACCESS_KEY=CHANGE_ME
RONGLI_OSS_SECRET_KEY=CHANGE_ME
# 访问域名：仅用于生成「直链」，对短链接无效（短链由 endpoint 签名，不受此项影响）。
# bucket 保持私有、靠短链访问时，这里填与上面 endpoint 同地域的公网地址即可，
# 例：https://CHANGE_ME.oss-cn-hangzhou.aliyuncs.com/ ，必须以 / 结尾。
RONGLI_OSS_DOMAIN=https://CHANGE_ME.oss-cn-XXXXXXXX.aliyuncs.com/
