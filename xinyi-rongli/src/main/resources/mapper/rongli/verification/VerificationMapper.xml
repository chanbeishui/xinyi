<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinyi.rongli.verification.mapper.VerificationMapper">
    <resultMap id="VerificationProof" type="com.xinyi.rongli.verification.domain.VerificationProof">
        <result property="id" column="id"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="updatedAt" column="updated_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="applicationId" column="application_id"/>
        <result property="ownerDeptId" column="owner_dept_id"/>
        <result property="companyRevision" column="company_revision"/>
        <result property="materialRevision" column="material_revision"/>
        <result property="materialHash" column="material_hash"/>
        <result property="provider" column="provider"/>
        <result property="taskType" column="task_type"/>
        <result property="providerTaskId" column="provider_task_id"/>
        <result property="status" column="status"/>
        <result property="resultDigest" column="result_digest"/>
        <result property="verifiedAt" column="verified_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="sourceKind" column="source_kind"/>
        <result property="sourceRecordId" column="source_record_id"/>
        <result property="sourceSessionId" column="source_session_id"/>
        <result property="canonicalResultCipher" column="canonical_result_cipher"/>
    </resultMap>
    <resultMap id="DeviceAuthenticationSession" type="com.xinyi.rongli.verification.domain.DeviceAuthenticationSession">
        <result property="id" column="id"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="updatedAt" column="updated_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="applicationId" column="application_id"/>
        <result property="ownerDeptId" column="owner_dept_id"/>
        <result property="companyRevision" column="company_revision"/>
        <result property="accountId" column="account_id"/>
        <result property="materialRevision" column="material_revision"/>
        <result property="materialHash" column="material_hash"/>
        <result property="verificationId" column="verification_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="contextVersion" column="context_version"/>
        <result property="appId" column="app_id"/>
        <result property="openIdMac" column="open_id_mac"/>
        <result property="status" column="status"/>
        <result property="launchMode" column="launch_mode"/>
        <result property="consentVersion" column="consent_version"/>
        <result property="consentTextHash" column="consent_text_hash"/>
        <result property="consentText" column="consent_text"/>
        <result property="consentAcceptedAt" column="consent_accepted_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="expiresAt" column="expires_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="resultAvailable" column="result_available"/>
        <result property="failureCode" column="failure_code"/>
        <result property="requestNo" column="request_no"/>
        <result property="requestMac" column="request_mac"/>
        <result property="configProfileId" column="config_profile_id"/>
        <result property="configRevisionId" column="config_revision_id"/>
        <result property="provider" column="provider"/>
        <result property="product" column="product"/>
        <result property="providerIdentityDigest" column="provider_identity_digest"/>
        <result property="configSnapshot" column="config_snapshot"/>
        <result property="challengeCipher" column="challenge_cipher"/>
        <result property="challengeMac" column="challenge_mac"/>
        <result property="submissionCipher" column="submission_cipher"/>
        <result property="submissionMac" column="submission_mac"/>
        <result property="submittedAt" column="submitted_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="executionStartedAt" column="execution_started_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="leaseToken" column="lease_token"/>
        <result property="leaseUntil" column="lease_until" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="verifiedAt" column="verified_at" typeHandler="com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler"/>
        <result property="resultDigest" column="result_digest"/>
    </resultMap>
    <select id="consent" resultType="map">
        SELECT config_key,config_value
        FROM sys_config
        WHERE config_key IN ('vi.biz.verification.consent.version','vi.biz.verification.consent.text')
        ORDER BY config_key
        <if test="lock">FOR UPDATE</if>
    </select>
    <select id="applicationAccount" resultType="long">
        SELECT profile.account_id
        FROM vi_driver_application application
        JOIN vi_driver_profile profile ON profile.id=application.driver_id
        WHERE application.id=#{applicationId}
    </select>
    <select id="find" resultMap="DeviceAuthenticationSession">
        SELECT * FROM vi_face_session WHERE id=#{id}
    </select>
    <select id="lock" resultMap="DeviceAuthenticationSession">
        SELECT * FROM vi_face_session WHERE id=#{id} FOR UPDATE
    </select>
    <select id="byRequest" resultMap="DeviceAuthenticationSession">
        SELECT * FROM vi_face_session WHERE request_no=#{requestNo} FOR UPDATE
    </select>
    <select id="active" resultMap="DeviceAuthenticationSession">
        SELECT * FROM vi_face_session WHERE active_device_context=CONCAT(#{application},':',#{session},':',#{context}) FOR UPDATE
    </select>
    <select id="current" resultMap="DeviceAuthenticationSession">
        SELECT *
        FROM vi_face_session
        WHERE application_id=#{application} AND owner_dept_id=#{company} AND company_revision=#{epoch}
            AND material_revision=#{material} AND material_hash=#{hash} AND session_id=#{session}
            AND (context_version=#{context} OR status IN ('PASSED','FAILED','EXPIRED','CLOSED'))
        ORDER BY id DESC
        LIMIT 1
    </select>
    <insert id="insertSession" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vi_face_session(
            application_id,owner_dept_id,company_revision,account_id,material_revision,
            material_hash,verification_id,session_id,context_version,app_id,
            open_id_mac,status,launch_mode,consent_version,consent_text_hash,
            consent_text,consent_accepted_at,expires_at,result_available,failure_code,
            request_no,request_mac,config_profile_id,config_revision_id,provider,
            product,provider_identity_digest,config_snapshot,challenge_cipher,challenge_mac,
            submission_cipher,submission_mac,submitted_at,execution_started_at,lease_token,
            lease_until,verified_at,result_digest,created_at
        )
        VALUES(
            #{applicationId},#{ownerDeptId},#{companyRevision},
            #{accountId},#{materialRevision},#{materialHash},
            #{verificationId},#{sessionId},#{contextVersion},
            #{appId},#{openIdMac},#{status},
            #{launchMode},#{consentVersion},#{consentTextHash},
            #{consentText},#{consentAcceptedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},#{expiresAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            #{resultAvailable},#{failureCode},#{requestNo},
            #{requestMac},#{configProfileId},#{configRevisionId},
            #{provider},#{product},#{providerIdentityDigest},
            #{configSnapshot},#{challengeCipher},#{challengeMac},
            #{submissionCipher},#{submissionMac},#{submittedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            #{executionStartedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},#{leaseToken},#{leaseUntil,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            #{verifiedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},#{resultDigest},
            #{createdAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler}
        )
    </insert>
    <update id="saveSession">
        UPDATE vi_face_session
        SET
            application_id=#{applicationId},
            owner_dept_id=#{ownerDeptId},
            company_revision=#{companyRevision},
            account_id=#{accountId},
            material_revision=#{materialRevision},
            material_hash=#{materialHash},
            verification_id=#{verificationId},
            session_id=#{sessionId},
            context_version=#{contextVersion},
            app_id=#{appId},
            open_id_mac=#{openIdMac},
            status=#{status},
            launch_mode=#{launchMode},
            consent_version=#{consentVersion},
            consent_text_hash=#{consentTextHash},
            consent_text=#{consentText},
            consent_accepted_at=#{consentAcceptedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            expires_at=#{expiresAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            result_available=#{resultAvailable},
            failure_code=#{failureCode},
            request_no=#{requestNo},
            request_mac=#{requestMac},
            config_profile_id=#{configProfileId},
            config_revision_id=#{configRevisionId},
            provider=#{provider},
            product=#{product},
            provider_identity_digest=#{providerIdentityDigest},
            config_snapshot=#{configSnapshot},
            challenge_cipher=#{challengeCipher},
            challenge_mac=#{challengeMac},
            submission_cipher=#{submissionCipher},
            submission_mac=#{submissionMac},
            submitted_at=#{submittedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            execution_started_at=#{executionStartedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            lease_token=#{leaseToken},
            lease_until=#{leaseUntil,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            verified_at=#{verifiedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},
            result_digest=#{resultDigest},
            version=version+1,updated_at=UTC_TIMESTAMP(3)
        WHERE id=#{id} AND version=#{version}
    </update>
    <sql id="visible">
        FROM vi_face_session session
        WHERE session.request_no IS NOT NULL
            AND session.provider='WECHAT_SOTER'
            AND session.product='WX_SOTER_DEVICE_AUTH'
        <if test="scope != null">
            <choose>
                <when test="scope.size()>0">
                    AND session.owner_dept_id IN
                    <foreach collection="scope" item="dept" open="(" close=")" separator=",">#{dept}</foreach>
                </when>
                <otherwise>AND 1=0</otherwise>
            </choose>
        </if>
        <if test="query.ownerDeptId != null">AND session.owner_dept_id=#{query.ownerDeptId}</if>
        <!-- GET不持久化过期状态；筛选须与安全投影相同，否则页面显示已失效却无法按已失效查到。 -->
        <if test="query.status != null">
            AND CASE
                WHEN session.status='CREATED' AND session.expires_at&lt;=UTC_TIMESTAMP(3) THEN 'EXPIRED'
                WHEN session.status='PROCESSING'
                    AND (session.lease_until IS NULL OR session.lease_until&lt;=UTC_TIMESTAMP(3)) THEN 'UNKNOWN'
                ELSE session.status
            END=#{query.status}
        </if>
        <if test="query.keyword != null and query.keyword != ''">
            AND (LOCATE(#{query.keyword},session.request_no)&gt;0 OR CAST(session.application_id AS CHAR)=#{query.keyword})
        </if>
    </sql>
    <select id="list" resultMap="DeviceAuthenticationSession">
        SELECT session.*
        <include refid="visible"/>
        ORDER BY session.id DESC
        LIMIT #{query.pageSize} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*)
        <include refid="visible"/>
    </select>
    <select id="currentProofs" resultMap="VerificationProof">
        SELECT *
        FROM vi_provider_verification
        WHERE application_id=#{application} AND owner_dept_id=#{company} AND company_revision=#{epoch}
            AND material_revision=#{material} AND material_hash=#{hash}
            AND task_type IN ('DEVICE_AUTH','BACKGROUND','LICENSE')
            AND verified_at IS NOT NULL AND verified_at&lt;=UTC_TIMESTAMP(3)
            AND source_kind IS NOT NULL AND source_record_id IS NOT NULL
            AND canonical_result_cipher IS NOT NULL
        ORDER BY id DESC
    </select>
    <select id="proof" resultMap="VerificationProof">
        SELECT * FROM vi_provider_verification WHERE id=#{id}
    </select>
    <select id="sourceProof" resultMap="VerificationProof">
        SELECT *
        FROM vi_provider_verification
        WHERE source_kind=#{kind} AND source_record_id=#{source} AND task_type=#{type}
    </select>
    <insert id="insertProof" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vi_provider_verification(
            application_id,owner_dept_id,company_revision,material_revision,material_hash,
            provider,task_type,provider_task_id,status,result_digest,verified_at,source_kind,source_record_id,source_session_id
        )
        VALUES(
            #{applicationId},#{ownerDeptId},#{companyRevision},#{materialRevision},#{materialHash},
            #{provider},#{taskType},#{providerTaskId},#{status},#{resultDigest},
            #{verifiedAt,typeHandler=com.xinyi.rongli.platform.mybatis.ViUtcInstantTypeHandler},#{sourceKind},#{sourceRecordId},#{sourceSessionId}
        )
    </insert>
    <update id="sealProof">
        UPDATE vi_provider_verification
        SET canonical_result_cipher=#{cipher}
        WHERE id=#{id} AND canonical_result_cipher IS NULL
    </update>
</mapper>
